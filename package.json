{
  "name": "toupeira",
"version": "0.6.0",
  "description": "Clean up what coding agents leave behind: merged git worktrees, their node_modules, and orphan session logs.",
  "keywords": [
    "claude-code",
    "codex",
    "coding-agent",
    "git-worktree",
    "worktree",
    "cleanup",
    "disk-space",
    "node-modules",
    "cli",
    "tui",
    "gemini-cli",
    "cursor",
    "t3-code"
  ],
  "homepage": "https://github.com/4ndreello/toupeira#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4ndreello/toupeira.git"
  },
  "bugs": {
    "url": "https://github.com/4ndreello/toupeira/issues"
  },
  "type": "module",
  "bin": {
    "toupeira": "index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info",
    "prepublishOnly": "node --test"
  },
