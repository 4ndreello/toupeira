{
  "name": "toupeira",
  "version": "0.6.4",
  "description": "Clean up what coding agents leave behind: merged git worktrees, their node_modules, and orphan session logs.",
  "keywords": [
    "claude-code",
    "codex",
    "coding-agent",
    "git-worktree",
    "worktree",
    "cleanup",
    "disk-space",
    "node-modules",
    "cli",
    "tui",
    "gemini-cli",
    "cursor",
    "t3-code"
  ],
  "homepage": "https://github.com/4ndreello/toupeira#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4ndreello/toupeira.git"
  },
  "bugs": {
    "url": "https://github.com/4ndreello/toupeira/issues"
  },
  "type": "module",
  "bin": {
    "toupeira": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "coverage": "npm run build && mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-lines=79 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info dist/test/*.test.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "author": "Gabriel Andreello",
  "license": "MIT",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/types.d.ts",
    "dist/types.js",
    "dist/lib"
  ],
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
